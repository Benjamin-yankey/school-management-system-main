# ── Server ────────────────────────────────────────────────────────────────
PORT=3000

# Comma-separated list of allowed CORS origins (frontend URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Database (single Postgres, schemas: auth / user / school / notification) ─
DATABASE_URL=postgres://school_user:password@localhost:5432/school

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
REDIS_URL=redis://localhost:6379

# ── Superadmin seed (created on first boot if no superadmin exists) ──────────
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=change-me

# ── Mail (notification module) ───────────────────────────────────────────────
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@example.com

# ── Notification broadcast self-calls ────────────────────────────────────────
# The monolith calls its own public endpoints (with the sender's token) when a
# broadcast targets a role/section. Point these at this app's own base URL.
SELF_URL=http://localhost:3000
USE_GATEWAY=false
